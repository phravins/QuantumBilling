# QuantumBilling — environment template
#
# Copy this file to `.env` and fill in your local values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is committed. When you add a variable,
# add it here too (with a placeholder, never a real secret) so the next person
# knows it exists.
#
# Loaded by config/runtime.exs. A real environment variable always wins over
# this file, so CI and production are unaffected by it. Every variable below
# has a working default for dev and test — an empty .env still boots.

# ── Database ────────────────────────────────────────────────────────────────
# The Postgres role and password Ecto connects with.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_PORT=5432

# Database names. The test suite appends MIX_TEST_PARTITION when set.
DB_NAME=quantum_billing_dev
DB_NAME_TEST=quantum_billing_test

# ── Application secret ──────────────────────────────────────────────────────
# Signs and encrypts session cookies and the LiveView socket. Generate one with:
#
#     mix phx.gen.secret
#
# Required in production — the app refuses to boot without it. Anyone holding
# this value can forge a session, so never reuse it across environments and
# never commit it.
SECRET_KEY_BASE=

# ── Production only ─────────────────────────────────────────────────────────
# Read by config/runtime.exs when MIX_ENV=prod. Leave blank for local work.
#
# Full connection URL, e.g. ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=
# Public hostname used to build URLs in emails and redirects.
PHX_HOST=
# Set to any value to start the web server when running a release.
PHX_SERVER=
# Connection pool size and IPv6 toggle.
POOL_SIZE=10
ECTO_IPV6=

# ── Mailer ──────────────────────────────────────────────────────────────────
# Account confirmation and password reset go through Swoosh. Development uses
# the local adapter — the mailbox is at http://localhost:4000/dev/mailbox and
# needs no credentials. Fill these in when you wire a real provider in
# config/runtime.exs.
MAILER_API_KEY=
MAILER_DOMAIN=
MAILER_FROM_EMAIL=

# ── OAuth ───────────────────────────────────────────────────────────────────
# The "Continue with GitHub" button on the sign-in screen is presentational
# today. Making it work needs the ueberauth and ueberauth_github dependencies
# plus a GitHub OAuth app; these are where its credentials will go.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Two factor authentication ───────────────────────────────────────────────
# Encrypts TOTP secrets at rest. Generate with `mix phx.gen.secret`.
# Required in production. Changing it invalidates every existing enrolment.
TOTP_ENCRYPTION_KEY=
