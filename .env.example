# Copy to .env (gitignored). Real environment variables win over this file.
# Every value has a working dev/test default, so an empty .env still boots.

# Database (dev and test)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_PORT=5432
DB_NAME=quantum_billing_dev
DB_NAME_TEST=quantum_billing_test

# Secrets: generate each with `mix phx.gen.secret`. Required in production.
SECRET_KEY_BASE=
# Changing it invalidates every 2FA enrolment.
TOTP_ENCRYPTION_KEY=
# Changing it means stored SMTP/Razorpay/IRP/webhook credentials must be re-entered.
SECRETS_ENCRYPTION_KEY=

# Production
DATABASE_URL=
PHX_HOST=
PHX_SERVER=
POOL_SIZE=10
ECTO_IPV6=
DB_QUEUE_TARGET_MS=150
DB_QUEUE_INTERVAL_MS=1000
DB_TIMEOUT_MS=15000

# Docker Compose (builds DATABASE_URL; the password must be URL-safe or percent-encoded)
DATABASE_USER=elixir_vibe
DATABASE_PASSWORD=
DATABASE_NAME=quantum_billing_prod

# Mail fallback relay; Settings > SMTP takes precedence. Dev mail goes to /dev/mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465); otherwise STARTTLS.
SMTP_SSL=
MAILER_FROM_EMAIL=
# false only for a self-signed relay on a trusted network.
SMTP_TLS_VERIFY=true

# GitHub sign-in (not wired up yet)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay; Settings > Integrations takes precedence.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true allows simulated payment links (demo only; already on in dev and test).
RAZORPAY_SANDBOX=
# Without it /api/webhooks/razorpay refuses every delivery.
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated proxy addresses/CIDRs whose x-forwarded-for is trusted.
TRUSTED_PROXIES=

# Empty searches PATH for chromium/google-chrome.
PDF_CHROME_PATH=

SLOW_QUERY_MS=500
