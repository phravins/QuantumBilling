# Copy to .env (gitignored). Real environment variables win over this file.
# Fill in credentials and secrets before starting the app or running tests.

# Database (dev and test)
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=localhost
DB_PORT=5432
DB_NAME=quantum_billing_dev
DB_NAME_TEST=quantum_billing_test

# Secrets: generate each with `mix phx.gen.secret`. Required in every environment.
SECRET_KEY_BASE=
# Changing it invalidates every 2FA enrolment.
TOTP_ENCRYPTION_KEY=
# Changing it means stored SMTP/Razorpay/IRP/webhook credentials must be re-entered.
SECRETS_ENCRYPTION_KEY=

# Required only when running seeds (including `mix ecto.setup`). No default account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=

# Production
DATABASE_URL=
PHX_HOST=
PHX_SERVER=
# Shared by web requests and Oban jobs (up to 32 at once); see config/runtime.exs.
POOL_SIZE=20
ECTO_IPV6=
DB_QUEUE_TARGET_MS=150
DB_QUEUE_INTERVAL_MS=1000
DB_TIMEOUT_MS=15000

# Mail fallback relay; Settings > SMTP takes precedence. Dev mail goes to /dev/mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465); otherwise STARTTLS.
SMTP_SSL=
MAILER_FROM_EMAIL=
# false only for a self-signed relay on a trusted network.
SMTP_TLS_VERIFY=true

# GitHub sign-in (not wired up yet)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Government portal integrations; leave blank when not configured.
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_SANDBOX=true
NIC_EWB_API_URL=
NIC_EWB_API_KEY=

# Razorpay; Settings > Integrations takes precedence.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true allows simulated payment links (demo only; already on in dev and test).
RAZORPAY_SANDBOX=
# Without it /api/webhooks/razorpay refuses every delivery.
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar OAuth client; without both, Settings > Integrations says it is
# not configured. The redirect URI to register is <your site>/integrations/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Comma-separated proxy addresses/CIDRs whose x-forwarded-for is trusted.
TRUSTED_PROXIES=

# Empty searches PATH for chromium/google-chrome.
PDF_CHROME_PATH=

SLOW_QUERY_MS=500
