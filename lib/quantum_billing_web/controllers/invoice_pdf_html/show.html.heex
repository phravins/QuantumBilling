<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@invoice.invoice_number}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 32px;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 12px;
        color: #18181b;
        background: #fff;
      }
      .sheet { max-width: 800px; margin: 0 auto; }
      .row { display: flex; justify-content: space-between; gap: 32px; }
      .brand { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
      .brand svg { width: 26px; height: 26px; flex: none; }
      .brand-name { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
      .label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #71717a;
      }
      .name { font-size: 13px; font-weight: 600; margin: 4px 0; }
      .muted { color: #52525b; white-space: pre-line; margin: 2px 0; }
      .meta { text-align: right; }
      .meta div { margin-bottom: 3px; }
      .meta span { color: #71717a; margin-right: 10px; }
      .meta b { font-weight: 600; }
      hr { border: 0; border-top: 1px solid #e4e4e7; margin: 20px 0; }
      table { width: 100%; border-collapse: collapse; margin-top: 8px; }
      th {
        text-align: left;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #71717a;
        border-bottom: 1px solid #e4e4e7;
        padding: 6px 8px 6px 0;
      }
      td { padding: 7px 8px 7px 0; border-bottom: 1px solid #f4f4f5; }
      .right { text-align: right; }
      .totals { width: 280px; margin-left: auto; margin-top: 16px; }
      .totals div { display: flex; justify-content: space-between; padding: 3px 0; }
      .grand {
        border-top: 1px solid #e4e4e7;
        margin-top: 6px;
        padding-top: 8px !important;
        font-weight: 600;
        font-size: 13px;
      }
      .words { margin-top: 20px; }
      /*
        `margin: 0` leaves the browser nowhere to draw its own print header and
        footer, which is what was stamping the date, the page title and the
        localhost URL onto the saved file. The page's own margin moves onto the
        body instead, so the document still sits inside a sensible border.
      */
      @page { size: A4; margin: 0; }
      @media print {
        body { padding: 14mm; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="sheet">
      <div class="row">
        <div>
          <%!-- The mark is inlined rather than pulled in through the app's
          icon classes: those are CSS masks defined in the application
          stylesheet, which this standalone page deliberately does not load, so
          the icon came out blank on the saved file. --%>
          <div class="brand">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m9 14.25 6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0c1.1.128 1.907 1.077 1.907 2.185ZM9.75 9h.008v.008H9.75V9Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm4.125 4.5h.008v.008h-.008V13.5Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
              />
            </svg>
            <span class="brand-name">QuantumBilling</span>
          </div>

          <p class="label">From</p>
          <p class="name">{@invoice.company_name || "—"}</p>
          <p :if={@invoice.company_address} class="muted">{@invoice.company_address}</p>
          <p :if={@invoice.company_gstin} class="muted">GSTIN: {@invoice.company_gstin}</p>
          <p :if={@invoice.company_state} class="muted">State: {@invoice.company_state}</p>
        </div>

        <div class="meta">
          <p class="name">{@invoice.invoice_number}</p>
          <div><span>Invoice Date</span><b>{Format.format_date(@invoice.invoice_date)}</b></div>
          <div><span>Due Date</span><b>{Format.format_date(@invoice.due_date)}</b></div>
          <div :if={@invoice.payment_terms}>
            <span>Payment Terms</span><b>{@invoice.payment_terms}</b>
          </div>
          <div><span>Place of Supply</span><b>{@invoice.place_of_supply}</b></div>
        </div>
      </div>

      <hr />

      <p class="label">Bill To</p>
      <p class="name">{@invoice.client_name}</p>
      <p :if={@invoice.client_billing_address} class="muted">{@invoice.client_billing_address}</p>
      <p :if={@invoice.client_gstin} class="muted">GSTIN: {@invoice.client_gstin}</p>
      <p :if={@invoice.client_email} class="muted">{@invoice.client_email}</p>

      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Item / Description</th>
            <th>HSN / SAC</th>
            <th class="right">Qty</th>
            <th>Unit</th>
            <th class="right">Rate</th>
            <th class="right">Tax %</th>
            <th class="right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={{item, index} <- Enum.with_index(@invoice.items, 1)}>
            <td>{index}</td>
            <td>{item.description}</td>
            <td>{item.hsn_sac || "—"}</td>
            <td class="right">{item.quantity}</td>
            <td>{item.unit}</td>
            <td class="right">{money(item.rate)}</td>
            <td class="right">{item.tax_rate}%</td>
            <td class="right">{money(line_amount(item))}</td>
          </tr>
        </tbody>
      </table>

      <div class="totals">
        <div><span>Taxable Value</span><span>{money(@invoice.taxable_value)}</span></div>
        <div :if={intra_state?(@invoice)}>
          <span>CGST</span><span>{money(@invoice.cgst_amount)}</span>
        </div>
        <div :if={intra_state?(@invoice)}>
          <span>SGST</span><span>{money(@invoice.sgst_amount)}</span>
        </div>
        <div :if={not intra_state?(@invoice)}>
          <span>IGST</span><span>{money(@invoice.igst_amount)}</span>
        </div>
        <div><span>Round Off</span><span>{money(@invoice.round_off)}</span></div>
        <div class="grand">
          <span>Grand Total</span><span>{money(@invoice.grand_total)}</span>
        </div>
      </div>

      <div class="words">
        <p class="label">Amount in Words</p>
        <p class="muted">{Format.rupees_in_words(@invoice.grand_total)}</p>
      </div>

      <p :if={@invoice.terms} class="words">
        <span class="label">Terms &amp; Conditions</span><br />
        <span class="muted">{@invoice.terms}</span>
      </p>
    </div>

    <script>
      // Straight into the print dialog, where "Save as PDF" writes the file.
      window.addEventListener("load", () => window.print())
    </script>
  </body>
</html>
