<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@invoice.invoice_number}</title>

    <%!-- Print-mode document stylesheet; app.css is not loaded, as its mask icons save blank in a PDF. --%>
    <Renderer.stylesheet doc={@doc} mode={:print} />
  </head>

  <body>
    <Renderer.document doc={@doc} invoice={@invoice} accent={@accent} logo={@logo} />
    <%!-- Raw script (no LiveSocket here), nonced because the layout is off and CSP silently blocks an un-nonced script. --%>
    <script nonce={@conn.assigns[:csp_nonce]}>
      // Straight into the print dialog, where "Save as PDF" writes the file.
      window.addEventListener("load", () => window.print())
    </script>
  </body>
</html>
