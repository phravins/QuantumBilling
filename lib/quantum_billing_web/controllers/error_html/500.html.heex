<%!-- Standalone document, same reasoning as 404.html.heex. No auth-aware link
here: a 500 may well be the session lookup itself failing. --%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong · QuantumBilling</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>

  <body class="antialiased">
    <div class="relative flex min-h-screen flex-col items-center justify-center bg-base-100 px-4 py-20">
      <div class="absolute left-4 top-4 flex items-center gap-2 text-lg font-semibold tracking-tight text-base-content md:left-8 md:top-8">
        <.icon name="hero-receipt-percent" class="size-6" /> QuantumBilling
      </div>

      <div class="mx-auto flex w-full max-w-md flex-col items-center text-center">
        <p class="text-5xl font-semibold tracking-tight text-base-content/20">500</p>

        <h1 class="mt-4 text-2xl font-semibold tracking-tight text-base-content">
          Something went wrong
        </h1>

        <p class="mt-2 text-sm text-base-content/60">
          An unexpected error occurred on our side. Please try again in a moment.
        </p>

        <.link
          href={~p"/"}
          class="mt-8 inline-flex h-9 items-center justify-center rounded-field bg-primary px-4 text-sm font-medium text-primary-content transition-colors hover:bg-primary/90"
        >
          Back to home
        </.link>
      </div>

      <p class="absolute inset-x-0 bottom-6 px-4 text-center text-xs text-base-content/60">
        GST invoicing, e-way bills and compliance — all in one place.
      </p>
    </div>
  </body>
</html>
