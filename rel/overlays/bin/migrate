#!/bin/sh
# Runs pending migrations against the configured database and exits.
#
# The compose stack runs this as a one-shot `migrate` service that the app
# waits on, so migrations happen exactly once per deploy rather than once per
# replica racing the others for the schema_migrations lock.
set -eu
cd -P -- "$(dirname -- "$0")"
exec ./quantum_billing eval QuantumBilling.Release.migrate
